<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_nav_btn"
                android:src="@drawable/ic_chevron_left"
                android:padding="8dp"
                android:layout_marginEnd="12dp"/>

            <TextView
                android:id="@+id/tvHeaderTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sự kiện mới"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#111827"/>
        </LinearLayout>

        <!-- Card form -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_white_card"
            android:padding="20dp">

            <!-- Tên sự kiện -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TÊN SỰ KIỆN"
                android:textSize="11sp"
                android:textColor="#5F5E5A"
                android:layout_marginBottom="6dp"/>

            <EditText
                android:id="@+id/etEventTitle"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input"
                android:paddingHorizontal="14dp"
                android:hint="Nhập sự kiện của bạn"
                android:textSize="14sp"
                android:layout_marginBottom="20dp"/>

            <!-- Ngày + Ưu tiên -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="NGÀY"
                        android:textSize="11sp"
                        android:textColor="#5F5E5A"
                        android:layout_marginBottom="6dp"/>

                    <TextView
                        android:id="@+id/tvPickedDate"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_input"
                        android:paddingHorizontal="14dp"
                        android:text="Chọn ngày"
                        android:textSize="14sp"
                        android:textColor="#2C2C2A"
                        android:gravity="center_vertical"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ƯU TIÊN"
                        android:textSize="11sp"
                        android:textColor="#5F5E5A"
                        android:layout_marginBottom="6dp"/>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <View
                            android:id="@+id/dotPriorityHigh"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:background="@drawable/bg_priority_dot_red"
                            android:layout_marginEnd="6dp"/>

                        <View
                            android:id="@+id/dotPriorityMed"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:background="@drawable/bg_priority_dot_orange"
                            android:layout_marginEnd="6dp"/>

                        <View
                            android:id="@+id/dotPriorityLow"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:background="@drawable/bg_priority_dot_green"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Giờ bắt đầu + kết thúc -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="BẮT ĐẦU"
                        android:textSize="11sp"
                        android:textColor="#5F5E5A"
                        android:layout_marginBottom="6dp"/>

                    <EditText
                        android:id="@+id/tvStartTime"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_input"
                        android:paddingHorizontal="14dp"
                        android:text="00:00"
                        android:textSize="14sp"
                        android:textColor="#2C2C2A"
                        android:gravity="center_vertical"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:clickable="true"
                        android:cursorVisible="true"
                        android:inputType="numberDecimal"
                        android:digits="0123456789:"
                        android:maxLength="5"
                        android:hint="HH:mm"
                        android:imeOptions="actionNext"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="KẾT THÚC"
                        android:textSize="11sp"
                        android:textColor="#5F5E5A"
                        android:layout_marginBottom="6dp"/>

                    <EditText
                        android:id="@+id/tvEndTime"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_input"
                        android:paddingHorizontal="14dp"
                        android:text="00:00"
                        android:textSize="14sp"
                        android:textColor="#2C2C2A"
                        android:gravity="center_vertical"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:clickable="true"
                        android:cursorVisible="true"
                        android:inputType="numberDecimal"
                        android:digits="0123456789:"
                        android:maxLength="5"
                        android:hint="HH:mm"
                        android:imeOptions="actionDone"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Địa điểm -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ĐỊA ĐIỂM"
                android:textSize="11sp"
                android:textColor="#5F5E5A"
                android:layout_marginBottom="6dp"/>

            <EditText
                android:id="@+id/etLocation"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input"
                android:paddingHorizontal="14dp"
                android:hint="Nhập địa điểm"
                android:textSize="14sp"
                android:layout_marginBottom="20dp"/>

            <!-- Màu sắc danh mục -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MÀU SẮC DANH MỤC"
                android:textSize="11sp"
                android:textColor="#5F5E5A"
                android:layout_marginBottom="10dp"/>

            <LinearLayout
                android:id="@+id/layoutColors"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="20dp">

                <FrameLayout android:layout_width="28dp" android:layout_height="28dp" android:layout_marginEnd="8dp">
                    <View android:id="@+id/colorRed" android:layout_width="28dp" android:layout_height="28dp" android:background="@drawable/bg_color_red"/>
                    <TextView android:id="@+id/checkRed" android:layout_width="match_parent" android:layout_height="match_parent" android:text="✓" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" android:gravity="center" android:visibility="gone"/>
                </FrameLayout>

                <FrameLayout android:layout_width="28dp" android:layout_height="28dp" android:layout_marginEnd="8dp">
                    <View android:id="@+id/colorBlue" android:layout_width="28dp" android:layout_height="28dp" android:background="@drawable/bg_color_blue"/>
                    <TextView android:id="@+id/checkBlue" android:layout_width="match_parent" android:layout_height="match_parent" android:text="✓" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" android:gravity="center" android:visibility="gone"/>
                </FrameLayout>

                <FrameLayout android:layout_width="28dp" android:layout_height="28dp" android:layout_marginEnd="8dp">
                    <View android:id="@+id/colorGreen" android:layout_width="28dp" android:layout_height="28dp" android:background="@drawable/bg_color_green"/>
                    <TextView android:id="@+id/checkGreen" android:layout_width="match_parent" android:layout_height="match_parent" android:text="✓" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" android:gravity="center" android:visibility="gone"/>
                </FrameLayout>

                <FrameLayout android:layout_width="28dp" android:layout_height="28dp" android:layout_marginEnd="8dp">
                    <View android:id="@+id/colorYellow" android:layout_width="28dp" android:layout_height="28dp" android:background="@drawable/bg_color_yellow"/>
                    <TextView android:id="@+id/checkYellow" android:layout_width="match_parent" android:layout_height="match_parent" android:text="✓" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" android:gravity="center" android:visibility="gone"/>
                </FrameLayout>

                <FrameLayout android:layout_width="28dp" android:layout_height="28dp" android:layout_marginEnd="8dp">
                    <View android:id="@+id/colorPurple" android:layout_width="28dp" android:layout_height="28dp" android:background="@drawable/bg_color_purple"/>
                    <TextView android:id="@+id/checkPurple" android:layout_width="match_parent" android:layout_height="match_parent" android:text="✓" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" android:gravity="center" android:visibility="visible"/>
                </FrameLayout>

                <FrameLayout android:layout_width="28dp" android:layout_height="28dp">
                    <View android:id="@+id/colorPink" android:layout_width="28dp" android:layout_height="28dp" android:background="@drawable/bg_color_pink"/>
                    <TextView android:id="@+id/checkPink" android:layout_width="match_parent" android:layout_height="match_parent" android:text="✓" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" android:gravity="center" android:visibility="gone"/>
                </FrameLayout>
            </LinearLayout>

            <!-- Divider -->
            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="#F0F0F0" android:layout_marginBottom="20dp"/>

            <!-- Sự kiện lặp lại -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SỰ KIỆN LẶP LẠI"
                        android:textSize="11sp"
                        android:textColor="#5F5E5A"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hằng tuần"
                        android:textSize="13sp"
                        android:textColor="#2C2C2A"/>
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchRepeat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:thumbTint="#FFFFFF"
                    android:trackTint="#A855F7"/>
            </LinearLayout>

            <!-- Chọn ngày lặp -->
            <LinearLayout
                android:id="@+id/layoutRepeatDays"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp"
                android:visibility="visible">

                <TextView android:id="@+id/dayT2" android:layout_width="36dp" android:layout_height="36dp" android:text="T2" android:gravity="center" android:textSize="12sp" android:textColor="#888780" android:background="@drawable/bg_day_normal" android:layout_marginEnd="6dp"/>
                <TextView android:id="@+id/dayT3" android:layout_width="36dp" android:layout_height="36dp" android:text="T3" android:gravity="center" android:textSize="12sp" android:textColor="#FFFFFF" android:background="@drawable/bg_day_selected" android:layout_marginEnd="6dp"/>
                <TextView android:id="@+id/dayT4" android:layout_width="36dp" android:layout_height="36dp" android:text="T4" android:gravity="center" android:textSize="12sp" android:textColor="#888780" android:background="@drawable/bg_day_normal" android:layout_marginEnd="6dp"/>
                <TextView android:id="@+id/dayT5" android:layout_width="36dp" android:layout_height="36dp" android:text="T5" android:gravity="center" android:textSize="12sp" android:textColor="#888780" android:background="@drawable/bg_day_normal" android:layout_marginEnd="6dp"/>
                <TextView android:id="@+id/dayT6" android:layout_width="36dp" android:layout_height="36dp" android:text="T6" android:gravity="center" android:textSize="12sp" android:textColor="#888780" android:background="@drawable/bg_day_normal" android:layout_marginEnd="6dp"/>
                <TextView android:id="@+id/dayT7" android:layout_width="36dp" android:layout_height="36dp" android:text="T7" android:gravity="center" android:textSize="12sp" android:textColor="#888780" android:background="@drawable/bg_day_normal" android:layout_marginEnd="6dp"/>
                <TextView android:id="@+id/dayCN" android:layout_width="36dp" android:layout_height="36dp" android:text="CN" android:gravity="center" android:textSize="12sp" android:textColor="#888780" android:background="@drawable/bg_day_normal"/>
            </LinearLayout>

            <!-- Nhắc nhở -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="NHẮC NHỞ"
                        android:textSize="11sp"
                        android:textColor="#5F5E5A"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Trước giờ bắt đầu"
                        android:textSize="13sp"
                        android:textColor="#2C2C2A"/>
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchReminder"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:thumbTint="#FFFFFF"
                    android:trackTint="#A855F7"/>
            </LinearLayout>

            <!-- Thời gian nhắc -->
            <LinearLayout
                android:id="@+id/layoutReminderTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="20dp"
                android:visibility="visible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Trước:"
                    android:textSize="13sp"
                    android:textColor="#5F5E5A"
                    android:layout_marginEnd="10dp"/>

                <EditText
                    android:id="@+id/etReminderMinutes"
                    android:layout_width="70dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_input"
                    android:paddingHorizontal="10dp"
                    android:text="15"
                    android:inputType="number"
                    android:textSize="15sp"
                    android:gravity="center"
                    android:layout_marginEnd="10dp"/>

                <Spinner
                    android:id="@+id/spinnerReminderUnit"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_input"
                    android:paddingHorizontal="10dp"
                    android:minWidth="90dp"/>
            </LinearLayout>

            <!-- Nút Lưu - góc phải -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="end">

                <Button
                    android:id="@+id/btnSaveEvent"
                    android:layout_width="120dp"
                    android:layout_height="52dp"
                    android:text="Lưu"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:background="@drawable/bg_btn_primary"
                    android:backgroundTint="@null"
                    android:stateListAnimator="@null"/>
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</ScrollView>
