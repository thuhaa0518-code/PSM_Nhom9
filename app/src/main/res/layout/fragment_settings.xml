<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ===== PHẦN HỒ SƠ (trên cùng) ===== -->

        <!-- Banner gradient tím -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_profile_banner"
            android:paddingHorizontal="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="28dp">

            <!-- Header row: Hồ sơ + nút Chỉnh sửa/Lưu -->
            <LinearLayout
                android:id="@+id/rowHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_alignParentTop="true">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Hồ sơ"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"/>

                <Button
                    android:id="@+id/btnEditSave"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:text="✏ Chỉnh sửa"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:background="@drawable/bg_badge_white_alpha"
                    android:paddingHorizontal="14dp"
                    android:stateListAnimator="@null"/>
            </LinearLayout>

            <!-- Avatar + info -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_below="@id/rowHeader"
                android:layout_marginTop="16dp">

                <TextView
                    android:id="@+id/tvAvatar"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_avatar_orange"
                    android:text="M"
                    android:textColor="#FFFFFF"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:gravity="center"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="16dp">

                    <TextView
                        android:id="@+id/tvUserName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nguyễn Văn Minh"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"/>

                    <TextView
                        android:id="@+id/tvUserEmail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="minhnguyenvan@gmail.com"
                        android:textSize="12sp"
                        android:textColor="#E0D4FF"
                        android:layout_marginTop="2dp"/>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sinh viên"
                            android:textSize="11sp"
                            android:textColor="#FFFFFF"
                            android:background="@drawable/bg_badge_white_alpha"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="3dp"/>

                        <TextView
                            android:id="@+id/tvStudentId"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="MSV: 21110234"
                            android:textSize="11sp"
                            android:textColor="#FFFFFF"
                            android:background="@drawable/bg_badge_white_alpha"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="3dp"
                            android:layout_marginStart="8dp"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </RelativeLayout>

        <!-- Stats card (nổi lên) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_white_card"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="-20dp"
            android:paddingVertical="16dp"
            android:elevation="4dp">

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                <TextView android:id="@+id/tvStatEvents"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="128" android:textSize="22sp" android:textStyle="bold"
                    android:textColor="#A855F7"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Sự kiện" android:textSize="12sp" android:textColor="#6B7280"/>
            </LinearLayout>

            <View android:layout_width="1dp" android:layout_height="40dp"
                android:background="#F3F4F6" android:layout_gravity="center_vertical"/>

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                <TextView android:id="@+id/tvStatDone"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="94%" android:textSize="22sp" android:textStyle="bold"
                    android:textColor="#10B981"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Hoàn thành" android:textSize="12sp" android:textColor="#6B7280"/>
            </LinearLayout>

            <View android:layout_width="1dp" android:layout_height="40dp"
                android:background="#F3F4F6" android:layout_gravity="center_vertical"/>

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="🔥" android:textSize="18sp"/>
                    <TextView android:id="@+id/tvStatStreak"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text=" 21" android:textSize="22sp" android:textStyle="bold"
                        android:textColor="#F59E0B"/>
                </LinearLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Chuỗi ngày" android:textSize="12sp" android:textColor="#6B7280"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Section label: THÔNG TIN CÁ NHÂN -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="10dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="👤" android:textSize="14sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text=" THÔNG TIN CÁ NHÂN"
                android:textSize="13sp" android:textStyle="bold" android:textColor="#374151"/>
        </LinearLayout>

        <!-- Info card: 4 trường xem/sửa -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_white_card"
            android:layout_marginHorizontal="16dp"
            android:padding="16dp">

            <!-- Họ và tên -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="top" android:layout_marginBottom="16dp">

                <LinearLayout android:layout_width="44dp" android:layout_height="44dp"
                    android:background="@drawable/bg_icon_purple" android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="🎓" android:textSize="20sp"/>
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="12dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Họ và tên" android:textSize="12sp" android:textColor="#9CA3AF"
                        android:layout_marginBottom="4dp"/>
                    <EditText
                        android:id="@+id/etFullName"
                        android:layout_width="match_parent" android:layout_height="44dp"
                        android:background="@drawable/bg_input_field"
                        android:paddingHorizontal="12dp"
                        android:text="Nguyễn Văn Minh"
                        android:textSize="14sp" android:textStyle="bold" android:textColor="#111827"
                        android:enabled="false"/>
                </LinearLayout>

                <!-- Nút xóa trường -->
                <TextView
                    android:id="@+id/btnClearName"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="✕" android:textSize="16sp" android:textColor="#9CA3AF"
                    android:layout_marginStart="8dp" android:layout_marginTop="12dp"
                    android:visibility="gone"/>
            </LinearLayout>

            <!-- Email -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="top" android:layout_marginBottom="16dp">

                <LinearLayout android:layout_width="44dp" android:layout_height="44dp"
                    android:background="@drawable/bg_icon_pink" android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="✉️" android:textSize="20sp"/>
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="12dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Email" android:textSize="12sp" android:textColor="#9CA3AF"
                        android:layout_marginBottom="4dp"/>
                    <EditText
                        android:id="@+id/etEmail"
                        android:layout_width="match_parent" android:layout_height="44dp"
                        android:background="@drawable/bg_input_field"
                        android:paddingHorizontal="12dp"
                        android:text="minhnguyenvan@gmail.com"
                        android:textSize="14sp" android:textStyle="bold" android:textColor="#111827"
                        android:inputType="textEmailAddress"
                        android:enabled="false"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/btnClearEmail"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="✕" android:textSize="16sp" android:textColor="#9CA3AF"
                    android:layout_marginStart="8dp" android:layout_marginTop="12dp"
                    android:visibility="gone"/>
            </LinearLayout>

            <!-- Số điện thoại -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="top" android:layout_marginBottom="16dp">

                <LinearLayout android:layout_width="44dp" android:layout_height="44dp"
                    android:background="@drawable/bg_icon_green" android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="📞" android:textSize="20sp"/>
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="12dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Số điện thoại" android:textSize="12sp" android:textColor="#9CA3AF"
                        android:layout_marginBottom="4dp"/>
                    <EditText
                        android:id="@+id/etPhone"
                        android:layout_width="match_parent" android:layout_height="44dp"
                        android:background="@drawable/bg_input_field"
                        android:paddingHorizontal="12dp"
                        android:hint="0912 543 789"
                        android:textColorHint="#9CA3AF"
                        android:textSize="14sp" android:textStyle="bold" android:textColor="#111827"
                        android:inputType="phone"
                        android:enabled="false"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/btnClearPhone"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="✕" android:textSize="16sp" android:textColor="#9CA3AF"
                    android:layout_marginStart="8dp" android:layout_marginTop="12dp"
                    android:visibility="gone"/>
            </LinearLayout>

            <!-- Ngày sinh -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="top">

                <LinearLayout android:layout_width="44dp" android:layout_height="44dp"
                    android:background="@drawable/bg_icon_yellow" android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="🎂" android:textSize="20sp"/>
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="12dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Ngày sinh" android:textSize="12sp" android:textColor="#9CA3AF"
                        android:layout_marginBottom="4dp"/>
                    <EditText
                        android:id="@+id/etBirthDate"
                        android:layout_width="match_parent" android:layout_height="44dp"
                        android:background="@drawable/bg_input_field"
                        android:paddingHorizontal="12dp"
                        android:hint="15/08/2003"
                        android:textColorHint="#9CA3AF"
                        android:textSize="14sp" android:textStyle="bold" android:textColor="#111827"
                        android:enabled="false"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/btnClearBirth"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="✕" android:textSize="16sp" android:textColor="#9CA3AF"
                    android:layout_marginStart="8dp" android:layout_marginTop="12dp"
                    android:visibility="gone"/>
            </LinearLayout>
        </LinearLayout>

        <!-- ===== PHẦN CÀI ĐẶT (lướt xuống) ===== -->

        <!-- Divider label -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="10dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="⚙" android:textSize="14sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text=" CÀI ĐẶT ỨNG DỤNG"
                android:textSize="13sp" android:textStyle="bold" android:textColor="#374151"/>
        </LinearLayout>

        <!-- Settings card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_white_card"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="16dp">

            <!-- Khóa sinh trắc học -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingHorizontal="16dp" android:paddingVertical="14dp">

                <LinearLayout android:layout_width="44dp" android:layout_height="44dp"
                    android:background="@drawable/bg_icon_pink" android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="🔒" android:textSize="20sp"/>
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="14dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Khóa sinh trắc học"
                        android:textSize="15sp" android:textStyle="bold" android:textColor="#111827"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Vân tay"
                        android:textSize="12sp" android:textColor="#9CA3AF"/>
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchBiometric"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:checked="true"/>
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F3F4F6"/>

            <!-- Đồng bộ đám mây -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingHorizontal="16dp" android:paddingVertical="14dp">

                <LinearLayout android:layout_width="44dp" android:layout_height="44dp"
                    android:background="@drawable/bg_icon_green" android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="☁️" android:textSize="20sp"/>
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="14dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Đồng bộ đám mây"
                        android:textSize="15sp" android:textStyle="bold" android:textColor="#111827"/>
                    <TextView android:id="@+id/tvLastSync"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Đồng bộ lần cuối: 9:38 AM"
                        android:textSize="12sp" android:textColor="#9CA3AF"/>
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchCloudSync"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:checked="true"/>
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F3F4F6"/>

            <!-- Ngôn ngữ -->
            <LinearLayout android:id="@+id/rowLanguage"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:paddingHorizontal="16dp" android:paddingVertical="14dp">

                <LinearLayout android:layout_width="44dp" android:layout_height="44dp"
                    android:background="@drawable/bg_icon_yellow" android:gravity="center">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="🌐" android:textSize="20sp"/>
                </LinearLayout>

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="14dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Ngôn ngữ"
                        android:textSize="15sp" android:textStyle="bold" android:textColor="#111827"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Tiếng Việt" android:textSize="12sp" android:textColor="#9CA3AF"/>
                </LinearLayout>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="›" android:textSize="20sp" android:textColor="#9CA3AF"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Đăng xuất -->
        <LinearLayout
            android:id="@+id/rowLogout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_logout_card"
            android:layout_marginHorizontal="16dp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="14dp"
            android:layout_marginBottom="32dp">

            <LinearLayout android:layout_width="44dp" android:layout_height="44dp"
                android:background="@drawable/bg_icon_pink" android:gravity="center">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="🚪" android:textSize="20sp"/>
            </LinearLayout>

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="14dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Đăng xuất"
                    android:textSize="15sp" android:textStyle="bold" android:textColor="#EF4444"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Thoát khỏi tài khoản này"
                    android:textSize="12sp" android:textColor="#9CA3AF"/>
            </LinearLayout>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="›" android:textSize="20sp" android:textColor="#EF4444"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
