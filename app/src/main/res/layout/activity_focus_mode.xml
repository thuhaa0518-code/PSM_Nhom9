<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="@drawable/bg_gradient_banner">

    <TextView
        android:id="@+id/tvFocusTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Đang tập trung"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="48dp"/>

    <TextView
        android:id="@+id/tvFocusTimer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="25:00"
        android:textColor="#FFFFFF"
        android:textSize="72sp"
        android:textStyle="bold"
        android:layout_marginBottom="64dp"/>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnStopFocus"
        android:layout_width="200dp"
        android:layout_height="52dp"
        android:text="Dừng lại"
        android:background="@drawable/bg_white_card"
        android:textColor="#A855F7"
        android:textSize="16sp"
        android:textStyle="bold"
        android:stateListAnimator="@null"/>

</LinearLayout>
