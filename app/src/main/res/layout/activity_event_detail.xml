<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_arrow_back"
                android:background="@drawable/bg_back_btn"
                android:padding="8dp"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Chi tiết sự kiện"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#111827"
                android:layout_marginStart="12dp"/>

            <ImageButton
                android:id="@+id/btnDelete"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@android:drawable/ic_menu_delete"
                android:background="@drawable/bg_oval_white"
                android:tint="#EF4444"
                android:padding="8dp"/>
        </LinearLayout>

        <!-- Color banner -->
        <LinearLayout
            android:id="@+id/cardColorBanner"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:background="@drawable/bg_oval_purple"
            android:layout_marginBottom="16dp"/>

        <!-- Main info card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_white_card"
            android:padding="20dp"
            android:layout_marginBottom="12dp">

            <!-- Title + priority badge -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/tvDetailTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Tên sự kiện"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#111827"/>

                <TextView
                    android:id="@+id/tvPriorityBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cao"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#DC2626"
                    android:background="@drawable/bg_priority_badge_red"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"/>
            </LinearLayout>

            <!-- Completed toggle -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Đánh dấu hoàn thành"
                    android:textSize="14sp"
                    android:textColor="#6B7280"/>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchCompleted"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="#F3F4F6" android:layout_marginBottom="16dp"/>

            <!-- Date -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView android:layout_width="28dp" android:layout_height="wrap_content"
                    android:textSize="16sp"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="8dp">

                    <TextView
                        android:id="@+id/tvDetailDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Thứ Hai, 27/1/2025"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#111827"/>

                    <TextView
                        android:id="@+id/tvDetailTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="08:00 → 10:00"
                        android:textSize="13sp"
                        android:textColor="#6B7280"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Location -->
            <LinearLayout
                android:id="@+id/rowLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp"
                android:visibility="gone">

                <TextView android:layout_width="28dp" android:layout_height="wrap_content"
                    android:textSize="16sp"/>

                <TextView
                    android:id="@+id/tvDetailLocation"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Phòng A203"
                    android:textSize="14sp"
                    android:textColor="#111827"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>

            <!-- Repeat -->
            <LinearLayout
                android:id="@+id/rowRepeat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp"
                android:visibility="gone">

                <TextView android:layout_width="28dp" android:layout_height="wrap_content"
                    android:textSize="16sp"/>

                <TextView
                    android:id="@+id/tvDetailRepeat"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Lặp lại"
                    android:textSize="14sp"
                    android:textColor="#111827"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>

            <!-- Reminder -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView android:layout_width="28dp" android:layout_height="wrap_content"
                    android:textSize="16sp"/>

                <TextView
                    android:id="@+id/tvDetailReminder"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Chưa bật nhắc nhở"
                    android:textSize="14sp"
                    android:textColor="#9CA3AF"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Note card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_white_card"
            android:padding="20dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GHI CHÚ"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#9CA3AF"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/etDetailNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="80dp"
                android:background="@drawable/bg_input_field"
                android:padding="12dp"
                android:hint="Thêm ghi chú..."
                android:textColorHint="#9CA3AF"
                android:textSize="14sp"
                android:textColor="#111827"
                android:gravity="top"
                android:inputType="textMultiLine"/>
        </LinearLayout>

        <!-- Edit button -->
        <Button
            android:id="@+id/btnEdit"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Chỉnh sửa sự kiện"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:background="@drawable/bg_gradient_button_login"
            android:layout_marginBottom="12dp"
            android:stateListAnimator="@null"
            android:backgroundTint="@null"/>

        <!-- Focus Mode button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnFocusMode"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Đếm ngược thời gian"
            android:textColor="#A855F7"
            android:textSize="15sp"
            android:background="@drawable/bg_white_card"
            android:stateListAnimator="@null"/>

    </LinearLayout>
</ScrollView>
