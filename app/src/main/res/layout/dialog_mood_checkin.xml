<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_white_card"
    android:padding="28dp">

    <!-- Tiêu đề -->
    <TextView
        android:id="@+id/tvMoodGreeting"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Chào buổi sáng, Minh!"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#111827"
        android:layout_marginBottom="6dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hôm nay bạn cảm thấy thế nào?"
        android:textSize="14sp"
        android:textColor="#6B7280"
        android:layout_marginBottom="24dp"/>

    <!-- 4 mood options -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="20dp">

        <!-- Mệt mỏi -->
        <LinearLayout
            android:id="@+id/moodTired"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="8dp">
            <TextView android:layout_width="48dp" android:layout_height="48dp"
                android:text="😴" android:textSize="32sp" android:gravity="center"
                android:id="@+id/iconTired"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Mệt mỏi" android:textSize="11sp" android:textColor="#6B7280"
                android:gravity="center" android:layout_marginTop="4dp"/>
        </LinearLayout>

        <!-- Bình thường -->
        <LinearLayout
            android:id="@+id/moodNormal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="8dp">
            <TextView android:layout_width="48dp" android:layout_height="48dp"
                android:text="😐" android:textSize="32sp" android:gravity="center"
                android:id="@+id/iconNormal"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Bình thường" android:textSize="11sp" android:textColor="#6B7280"
                android:gravity="center" android:layout_marginTop="4dp"/>
        </LinearLayout>

        <!-- Tốt -->
        <LinearLayout
            android:id="@+id/moodGood"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="8dp">
            <TextView android:layout_width="48dp" android:layout_height="48dp"
                android:text="😊" android:textSize="32sp" android:gravity="center"
                android:id="@+id/iconGood"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Tốt" android:textSize="11sp" android:textColor="#6B7280"
                android:gravity="center" android:layout_marginTop="4dp"/>
        </LinearLayout>

        <!-- Hứng khởi -->
        <LinearLayout
            android:id="@+id/moodFire"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="8dp">
            <TextView android:layout_width="48dp" android:layout_height="48dp"
                android:text="🔥" android:textSize="32sp" android:gravity="center"
                android:id="@+id/iconFire"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Hứng khởi" android:textSize="11sp" android:textColor="#6B7280"
                android:gravity="center" android:layout_marginTop="4dp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Feedback message -->
    <TextView
        android:id="@+id/tvMoodFeedback"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_chip_purple"
        android:padding="14dp"
        android:text=""
        android:textSize="14sp"
        android:textColor="#7C3AED"
        android:gravity="center"
        android:visibility="gone"
        android:layout_marginBottom="16dp"/>

    <!-- Nút Bắt đầu ngày mới -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnStartDay"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Bắt đầu ngày mới"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        android:background="@drawable/bg_gradient_button_login"
        android:stateListAnimator="@null"/>

</LinearLayout>
