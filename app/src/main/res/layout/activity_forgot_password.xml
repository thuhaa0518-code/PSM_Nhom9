<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="28dp">

        <!-- Progress bar 3 bước -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="28dp">

            <View android:id="@+id/step1Bar"
                android:layout_width="0dp" android:layout_height="4dp"
                android:layout_weight="1" android:background="#A855F7"
                android:layout_marginEnd="6dp"/>
            <View android:id="@+id/step2Bar"
                android:layout_width="0dp" android:layout_height="4dp"
                android:layout_weight="1" android:background="#E0D9FF"
                android:layout_marginEnd="6dp"/>
            <View android:id="@+id/step3Bar"
                android:layout_width="0dp" android:layout_height="4dp"
                android:layout_weight="1" android:background="#E0D9FF"/>
        </LinearLayout>

        <!-- Nút quay lại -->
        <TextView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← Quay lại"
            android:textSize="14sp"
            android:textColor="#A855F7"
            android:textStyle="bold"
            android:layout_marginBottom="24dp"/>

        <!-- ===== BƯỚC 1: Nhập email ===== -->
        <LinearLayout
            android:id="@+id/layoutStep1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Quên mật khẩu?"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#111827"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nhập email hoặc MSSV để nhận mã xác nhận khôi phục tài khoản"
                android:textSize="14sp"
                android:textColor="#6B7280"
                android:layout_marginBottom="32dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EMAIL / MÃ SỐ SINH VIÊN"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#374151"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/etEmailOrMssv"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_input_field"
                android:paddingHorizontal="16dp"
                android:hint="Nhập email hoặc MSSV"
                android:textColorHint="#9CA3AF"
                android:textColor="#111827"
                android:textSize="14sp"
                android:inputType="textEmailAddress"
                android:layout_marginBottom="24dp"/>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSendOtp"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="Gửi mã xác nhận"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:background="@drawable/bg_gradient_button_login"
                android:backgroundTint="@null"
                android:stateListAnimator="@null"/>
        </LinearLayout>

        <!-- ===== BƯỚC 2: Nhập OTP ===== -->
        <LinearLayout
            android:id="@+id/layoutStep2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nhập mã OTP"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#111827"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tvOtpHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mã 4 chữ số đã gửi đến email của bạn"
                android:textSize="14sp"
                android:textColor="#6B7280"
                android:layout_marginBottom="32dp"/>

            <!-- 4 ô OTP -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="16dp">

                <EditText android:id="@+id/otp1"
                    android:layout_width="60dp" android:layout_height="64dp"
                    android:background="@drawable/bg_otp_box"
                    android:gravity="center" android:textSize="24sp" android:textStyle="bold"
                    android:textColor="#A855F7" android:inputType="number"
                    android:maxLength="1" android:layout_marginEnd="10dp"/>
                <EditText android:id="@+id/otp2"
                    android:layout_width="60dp" android:layout_height="64dp"
                    android:background="@drawable/bg_otp_box"
                    android:gravity="center" android:textSize="24sp" android:textStyle="bold"
                    android:textColor="#A855F7" android:inputType="number"
                    android:maxLength="1" android:layout_marginEnd="10dp"/>
                <EditText android:id="@+id/otp3"
                    android:layout_width="60dp" android:layout_height="64dp"
                    android:background="@drawable/bg_otp_box"
                    android:gravity="center" android:textSize="24sp" android:textStyle="bold"
                    android:textColor="#A855F7" android:inputType="number"
                    android:maxLength="1" android:layout_marginEnd="10dp"/>
                <EditText android:id="@+id/otp4"
                    android:layout_width="60dp" android:layout_height="64dp"
                    android:background="@drawable/bg_otp_box"
                    android:gravity="center" android:textSize="24sp" android:textStyle="bold"
                    android:textColor="#A855F7" android:inputType="number"
                    android:maxLength="1"/>
            </LinearLayout>

            <!-- Đếm ngược gửi lại -->
            <TextView
                android:id="@+id/tvResendTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gửi lại sau 60s"
                android:textSize="13sp"
                android:textColor="#6B7280"
                android:layout_gravity="center"
                android:layout_marginBottom="24dp"/>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnVerifyOtp"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="Xác nhận"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:background="@drawable/bg_gradient_button_login"
                android:backgroundTint="@null"
                android:stateListAnimator="@null"/>
        </LinearLayout>

        <!-- ===== BƯỚC 3: Đặt mật khẩu mới ===== -->
        <LinearLayout
            android:id="@+id/layoutStep3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Đặt mật khẩu mới"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#111827"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mật khẩu phải có ít nhất 6 ký tự"
                android:textSize="14sp"
                android:textColor="#6B7280"
                android:layout_marginBottom="32dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MẬT KHẨU MỚI"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#374151"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/etNewPassword"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_input_field"
                android:paddingHorizontal="16dp"
                android:hint="Nhập mật khẩu mới"
                android:textColorHint="#9CA3AF"
                android:textColor="#111827"
                android:textSize="14sp"
                android:inputType="textPassword"
                android:layout_marginBottom="20dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="XÁC NHẬN MẬT KHẨU"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#374151"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/etConfirmPassword"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_input_field"
                android:paddingHorizontal="16dp"
                android:hint="Nhập lại mật khẩu"
                android:textColorHint="#9CA3AF"
                android:textColor="#111827"
                android:textSize="14sp"
                android:inputType="textPassword"
                android:layout_marginBottom="24dp"/>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnResetPassword"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="Đặt lại mật khẩu"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:background="@drawable/bg_gradient_button_login"
                android:backgroundTint="@null"
                android:stateListAnimator="@null"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
