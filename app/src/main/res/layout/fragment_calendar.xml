<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- ── HEADER: tháng + nút prev/next ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="2dp"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvMonthYear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tháng 1 - 2026"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#111827"/>

            <TextView
                android:id="@+id/tvMonthEventCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="30 sự kiện trong tháng"
                android:textSize="13sp"
                android:textColor="#6B7280"
                android:layout_marginTop="2dp"/>
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnPrevMonth"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_nav_btn"
            android:src="@drawable/ic_chevron_left"
            android:padding="7dp"
            android:layout_marginEnd="6dp"/>

        <ImageButton
            android:id="@+id/btnNextMonth"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_nav_btn"
            android:src="@drawable/ic_chevron_right"
            android:padding="7dp"/>
    </LinearLayout>

    <!-- ── TABS: Ngày / Tuần / Tháng ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_tab_container"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="12dp"
        android:padding="4dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/tabDay"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Ngày"
            android:textSize="13sp"
            android:textColor="#6B7280"
            android:background="@drawable/bg_tab_normal"/>

        <TextView
            android:id="@+id/tabWeek"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Tuần"
            android:textSize="13sp"
            android:textColor="#6B7280"
            android:background="@drawable/bg_tab_normal"/>

        <TextView
            android:id="@+id/tabMonth"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Tháng"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_tab_active"/>
    </LinearLayout>

    <!-- ── NỘI DUNG (thay đổi theo tab) ── -->
    <LinearLayout
        android:id="@+id/calendarContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- ===== CHẾ ĐỘ THÁNG ===== -->
        <LinearLayout
            android:id="@+id/viewMonth"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:visibility="visible">

            <!-- PHẦN LỊCH: chiếm 1/3 màn hình -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- Tiêu đề thứ -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="28dp"
                    android:orientation="horizontal"
                    android:paddingHorizontal="8dp">

                    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="T2" android:textSize="11sp" android:textColor="#6B7280"/>
                    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="T3" android:textSize="11sp" android:textColor="#6B7280"/>
                    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="T4" android:textSize="11sp" android:textColor="#6B7280"/>
                    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="T5" android:textSize="11sp" android:textColor="#6B7280"/>
                    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="T6" android:textSize="11sp" android:textColor="#6B7280"/>
                    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="T7" android:textSize="11sp" android:textColor="#EF4444"/>
                    <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="CN" android:textSize="11sp" android:textColor="#EF4444"/>
                </LinearLayout>

                <!-- Lưới lịch: fill phần còn lại của 1/3 -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvCalendarGrid"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:paddingHorizontal="8dp"
                    android:nestedScrollingEnabled="false"/>
            </LinearLayout>

            <!-- Divider -->
            <View android:layout_width="match_parent" android:layout_height="1dp"
                android:background="#E5E7EB"/>

            <!-- PHẦN SỰ KIỆN: chiếm 2/3 màn hình -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="2"
                android:orientation="vertical">

                <!-- Label sự kiện + đếm -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="20dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="4dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Sự kiện sắp tới"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#111827"/>

                    <TextView
                        android:id="@+id/tvEventCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="12sp"
                        android:textColor="#A855F7"/>
                </LinearLayout>

                <!-- Danh sách sự kiện -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvUpcomingEvents"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:paddingHorizontal="16dp"
                    android:paddingBottom="16dp"
                    android:clipToPadding="false"/>
            </LinearLayout>
        </LinearLayout>

        <!-- ===== CHẾ ĐỘ TUẦN ===== -->
        <LinearLayout
            android:id="@+id/viewWeek"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Dải ngày tuần kiểu trang chủ -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvWeekStrip"
                android:layout_width="match_parent"
                android:layout_height="88dp"
                android:paddingHorizontal="8dp"
                android:clipToPadding="false"/>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E5E7EB"/>

            <!-- Label -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp"
                android:paddingTop="12dp"
                android:paddingBottom="6dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:id="@+id/tvWeekLabel"
                    android:text="Sự kiện trong tuần"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#111827"/>
            </LinearLayout>

            <!-- Danh sách sự kiện tuần -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvWeekEvents"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:paddingHorizontal="20dp"
                android:paddingBottom="16dp"
                android:clipToPadding="false"/>
        </LinearLayout>

        <!-- ===== CHẾ ĐỘ NGÀY ===== -->
        <LinearLayout
            android:id="@+id/viewDay"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Date strip 7 ngày -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvDayStrip"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:paddingHorizontal="12dp"
                android:clipToPadding="false"/>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E5E7EB"/>

            <!-- Label ngày đang chọn -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp"
                android:paddingTop="12dp"
                android:paddingBottom="6dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvDayViewLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Hôm nay"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#111827"/>
            </LinearLayout>

            <!-- Danh sách sự kiện ngày -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvDayEvents"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:paddingHorizontal="20dp"
                android:paddingBottom="16dp"
                android:clipToPadding="false"/>

            <!-- Empty state -->
            <LinearLayout
                android:id="@+id/layoutDayEmpty"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Không có sự kiện ngày này"
                    android:textSize="14sp" android:textColor="#9CA3AF"/>
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</LinearLayout>
