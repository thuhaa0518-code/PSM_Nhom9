<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="42dp"
    android:orientation="vertical"
    android:gravity="center">

    <TextView
        android:id="@+id/tvCalDay"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:gravity="center"
        android:textSize="12sp"
        android:textColor="#111827"/>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="5dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="2dp">

        <View android:id="@+id/dot1" android:layout_width="4dp" android:layout_height="4dp"
            android:background="@drawable/bg_oval_purple" android:visibility="gone"/>
        <View android:id="@+id/dot2" android:layout_width="4dp" android:layout_height="4dp"
            android:background="@drawable/bg_oval_purple" android:visibility="gone"
            android:layout_marginStart="2dp"/>
        <View android:id="@+id/dot3" android:layout_width="4dp" android:layout_height="4dp"
            android:background="@drawable/bg_oval_purple" android:visibility="gone"
            android:layout_marginStart="2dp"/>
    </LinearLayout>

</LinearLayout>
